# One block per endpoint to measure. The name after TARGET_ becomes the provider id in the results.
TARGET_MINE_ENDPOINT=https://s3.example.com
TARGET_MINE_BUCKET=bench
TARGET_MINE_ACCESS_KEY_ID=
TARGET_MINE_SECRET_ACCESS_KEY=
# TARGET_MINE_REGION=us-east-1
# TARGET_MINE_LABEL=My storage
# TARGET_MINE_PATH_STYLE=true

# How to run.
CLIENT=my-laptop
PROFILE=smoke
PASSES=1

# Where to upload the results. Leave RESULTS_ENDPOINT empty to keep them in /results only.
RESULTS_ENDPOINT=
RESULTS_BUCKET=
RESULTS_ACCESS_KEY_ID=
RESULTS_SECRET_ACCESS_KEY=
# RESULTS_REGION=us-east-1
# RESULTS_PREFIX=results
# RESULTS_PATH_STYLE=true
